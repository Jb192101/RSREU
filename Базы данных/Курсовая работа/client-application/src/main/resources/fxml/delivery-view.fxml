<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jedi_bachelor.course_paper_db.client.ui.controllers.DeliveryController"
      style="-fx-padding: 20; -fx-background-color: white;">

    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Поиск доставок..." HBox.hgrow="ALWAYS"/>
        <Button text="Найти" onAction="#handleSearch"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="Создать отправление" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="deliveryTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="orderColumn" text="Заказ" prefWidth="80"/>
            <TableColumn fx:id="carrierColumn" text="Перевозчик" prefWidth="150"/>
            <TableColumn fx:id="trackingColumn" text="Трек-номер" prefWidth="150"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="120"/>
            <TableColumn fx:id="shippedDateColumn" text="Дата отправки" prefWidth="150"/>
            <TableColumn fx:id="deliveredDateColumn" text="Дата доставки" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button fx:id="editButton" text="Редактировать" onAction="#handleEdit"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#handleDelete"/>
        <Button fx:id="refreshButton" text="Обновить" onAction="#handleRefresh"/>
        <Button text="Обновить статус" onAction="#handleUpdateStatus"/>
    </HBox>
</VBox>