@startuml
!theme plain

title ER-диаграмма «Книжный магазин»

' Определение сущностей
entity "Клиенты" as customers {
  * customer_id : BIGINT <<PK>>
  --
  first_name : VARCHAR(100) <<NOT NULL>>
  last_name : VARCHAR(100) <<NOT NULL>>
  email : VARCHAR(255) <<UNIQUE>>
  phone : VARCHAR(50)
  registration_date : DATE <<DEFAULT CURRENT_DATE>>
  loyalty_points : INTEGER <<DEFAULT 0, >=0>>
}

entity "Заказы" as orders {
  * order_id : BIGINT <<PK>>
  --
  order_date : TIMESTAMP <<DEFAULT CURRENT_TIMESTAMP>>
  total_amount : DECIMAL(10,2) <<NOT NULL, >0>>
  discount_amount : DECIMAL(10,2) <<DEFAULT 0, >=0>>
  status : VARCHAR(50) <<NOT NULL>>
  shipping_address : TEXT <<NOT NULL>>
  # customer_id : BIGINT <<FK>>
  # promo_code_id : BIGINT <<FK>>
}

entity "Позиции заказа" as order_items {
  * order_item_id : BIGINT <<PK>>
  --
  quantity : INTEGER <<NOT NULL, >0>>
  unit_price : DECIMAL(10,2) <<NOT NULL, >=0>>
  # order_id : BIGINT <<FK>>
  # book_id : BIGINT <<FK>>
}

entity "Книги" as books {
  * book_id : BIGINT <<PK>>
  --
  isbn : VARCHAR(20) <<UNIQUE, NOT NULL>>
  title : VARCHAR(200) <<NOT NULL>>
  publication_year : INTEGER
  price : DECIMAL(10,2) <<NOT NULL, >0>>
  pages : INTEGER <<>0>>
  description : TEXT
  # publisher_id : BIGINT <<FK>>
  # genre_id : BIGINT <<FK>>
}

entity "Издательства" as publishers {
  * publisher_id : BIGINT <<PK>>
  --
  name : VARCHAR(255) <<NOT NULL, UNIQUE>>
  phone : VARCHAR(50)
  email : VARCHAR(255)
  address : TEXT
}

entity "Авторы" as authors {
  * author_id : BIGINT <<PK>>
  --
  first_name : VARCHAR(100) <<NOT NULL>>
  last_name : VARCHAR(100) <<NOT NULL>>
  birth_date : DATE
  country : VARCHAR(100)
  biography : TEXT
}

entity "Книги-Авторы" as book_authors {
  * book_id : BIGINT <<FK, PK>>
  * author_id : BIGINT <<FK, PK>>
  --
  author_order : INTEGER <<NOT NULL, DEFAULT 1, >0>>
}

entity "Складские остатки" as inventory {
  * inventory_id : BIGINT <<PK>>
  --
  quantity : INTEGER <<NOT NULL, DEFAULT 0, >=0>>
  reserved_quantity : INTEGER <<DEFAULT 0, >=0>>
  last_restocked : DATE
  # book_id : BIGINT <<FK, UNIQUE>>
}

' НОВАЯ сущность 1: Жанры (вынесено из books для нормализации)
entity "Жанры" as genres {
  * genre_id : BIGINT <<PK>>
  --
  name : VARCHAR(50) <<UNIQUE, NOT NULL>>
  parent_genre_id : BIGINT <<FK>>  ' для иерархии (например, Фантастика -> Научная фантастика)
  description : TEXT
}

' НОВАЯ сущность 2: Отзывы и рейтинги
entity "Отзывы" as reviews {
  * review_id : BIGINT <<PK>>
  --
  rating : INTEGER <<NOT NULL, 1-5>>
  comment : TEXT
  review_date : TIMESTAMP <<DEFAULT CURRENT_TIMESTAMP>>
  is_verified_purchase : BOOLEAN <<DEFAULT FALSE>>
  # customer_id : BIGINT <<FK>>
  # book_id : BIGINT <<FK>>
}

' НОВАЯ сущность 3: Промокоды / Купоны
entity "Промокоды" as promocodes {
  * promo_code_id : BIGINT <<PK>>
  --
  code : VARCHAR(50) <<UNIQUE, NOT NULL>>
  discount_type : VARCHAR(20) <<NOT NULL>>  ' PERCENT или FIXED
  discount_value : DECIMAL(10,2) <<NOT NULL, >0>>
  valid_from : DATE <<NOT NULL>>
  valid_to : DATE <<NOT NULL>>
  max_uses : INTEGER
  used_count : INTEGER <<DEFAULT 0>>
  min_order_amount : DECIMAL(10,2) <<DEFAULT 0>>
}

' НОВАЯ сущность 4: Доставка (расширение логистики)
entity "Доставка" as shipments {
  * shipment_id : BIGINT <<PK>>
  --
  tracking_number : VARCHAR(100)
  carrier : VARCHAR(100) <<NOT NULL>>
  shipped_date : TIMESTAMP
  delivered_date : TIMESTAMP
  status : VARCHAR(50) <<NOT NULL>>
  # order_id : BIGINT <<FK, UNIQUE>>
}

' Связи
customers ||--o{ orders : "оформляет"
orders ||--|{ order_items : "содержит"
order_items }o--|| books : "ссылается на"
books }o--|| publishers : "выпускается"
books ||--o{ book_authors : "имеет"
authors ||--o{ book_authors : "написал"
books ||--|| inventory : "учитывается на складе"

' Связи для новых сущностей
books }o--|| genres : "относится к"
customers ||--o{ reviews : "оставляет"
books ||--o{ reviews : "получает"
promocodes ||--o{ orders : "применяется к"
orders ||--|| shipments : "отправляется через"

note right of reviews
  is_verified_purchase = TRUE
  только для клиентов,
  купивших книгу
end note

@enduml